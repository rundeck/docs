{
  "index_name": "prod_rundeck_docs",
  "js_render": false,
  "start_urls": [
    {
      "url": "https://docs.rundeck.com/(?P<version>.*?)/",
      "variables": {
        "version": [
          "docs",
          "4.0.x",
          "5.16.0"
        ]
      }
    }
  ],
  "stop_urls": [
    "https://docs.rundeck.com/.*?/history/[1,2].*?/.*"
  ],
  "selectors": {
    "default": {
      "lvl0": {
        "selector": ".vp-sidebar > .vp-sidebar-links > li > .vp-sidebar-group > p.vp-sidebar-header.active .vp-sidebar-title",
        "global": true,
        "default_value": "Documentation"
      },
      "lvl1": "#markdown-content h1",
      "lvl2": "#markdown-content h2",
      "lvl3": "#markdown-content h3",
      "text": [
        "#markdown-content p",
        "#markdown-content li",
        "#markdown-content td",
        "#markdown-content th",
        "#markdown-content code",
        "#markdown-content pre",
        "#markdown-content blockquote",
        "#markdown-content dt",
        "#markdown-content dd",
        "#markdown-content figcaption",
        "#markdown-content .hint-container"
      ],
      "lang": {
        "selector": "/html/@lang",
        "type": "xpath",
        "global": true
      }
    }
  },
  "selectors_exclude": [
    ".table-of-contents"
  ],
  "strip_chars": " .,;:#",
  "only_content_level": true,
  "custom_settings": {
    "attributesForFaceting": [
      "version",
      "lang"
    ]
  }
}